FLASK_SECRET_KEY=your-secret-key-here
FLASK_ENV=development
APP_NAME=Media Tracker
TAILSCALE_IP=127.0.0.1
PORT=5001
PROFILES=Default

# External provider keys — leave blank to disable that provider silently.
TMDB_API_KEY=
RAWG_API_KEY=

# MusicBrainz requires a contact string in the User-Agent. Format: "media-tracker/1.0 ( you@example.com )"
MUSICBRAINZ_USER_AGENT=media-tracker/1.0 ( you@example.com )
